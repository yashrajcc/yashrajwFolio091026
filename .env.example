# Local SQLite (default for npm run dev)
DATABASE_URL=file:./payload.db
PAYLOAD_SECRET=replace-with-a-long-random-string
# SEED_ON_INIT=false

# Production / Vercel uses Neon Postgres (set in Vercel dashboard):
# DATABASE_URL=postgresql://...
# POSTGRES_URL=postgresql://...
# PAYLOAD_SECRET=<strong random secret>
